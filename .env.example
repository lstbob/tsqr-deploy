# Copy to .env and replace every CHANGE_ME value. .env is gitignored — never commit real secrets.

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=tsqr
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Tool Library API connection string (must match the Postgres user/password above)
TOOL_LIB_CONNECTION=Host=postgres;Port=5432;Database=tsqr_tool_library;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Auth service connection string
AUTHEO_CONNECTION=Host=postgres;Port=5432;Database=tsqr_autheo;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Identity service connection string
IDENTITY_CONNECTION=Host=postgres;Port=5432;Database=tsqr_identity;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Support service connection string
SUPPORT_CONNECTION=Host=postgres;Port=5432;Database=tsqr_support;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Soup kitchen service connection string
SOUP_KITCHEN_CONNECTION=Host=postgres;Port=5432;Database=tsqr_soup_kitchen;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Communities service connection string
COMMUNITIES_CONNECTION=Host=postgres;Port=5432;Database=tsqr_communities;Username=tsqr;Password=CHANGE_ME_strong_db_password


# GitHub Packages token (needed to restore tsqr-common NuGet package).
# Create one at GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens
# with at least `read:packages` scope on the lstbob org.
GITHUB_PACKAGES_TOKEN=CHANGE_ME_github_packages_token

# Shared JWT signing key for gateway + tool-lib + autheo + support (HMAC, must be >= 32 chars).
# Generate a random one, e.g.:  openssl rand -base64 48
# MUST be identical across all four services.
JWT_KEY=CHANGE_ME_generate_a_random_key_at_least_32_chars

# Service-to-service key for autheo's internal change-email endpoint.
# Identity sends it as X-Internal-Api-Key; the public gateway does not.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_generate_a_random_key

# Next.js UI -> gateway (internal)
API_URL=http://gateway:8080

# Support UI external URL (for the Support tab link in tsqr-ui)
NEXT_PUBLIC_SUPPORT_URL=http://localhost:4200
