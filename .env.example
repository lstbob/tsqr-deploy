# Copy to .env and replace every CHANGE_ME value. .env is gitignored — never commit real secrets.

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=tsqr
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Tool Library API connection string (must match the Postgres user/password above)
TOOL_LIB_CONNECTION=Host=postgres;Port=5432;Database=tsqr_tool_library;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Auth service connection string
AUTHEO_CONNECTION=Host=postgres;Port=5432;Database=tsqr_autheo;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Identity service connection string
IDENTITY_CONNECTION=Host=postgres;Port=5432;Database=tsqr_identity;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Support service connection string
SUPPORT_CONNECTION=Host=postgres;Port=5432;Database=tsqr_support;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Soup kitchen service connection string
SOUP_KITCHEN_CONNECTION=Host=postgres;Port=5432;Database=tsqr_soup_kitchen;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Communities service connection string
COMMUNITIES_CONNECTION=Host=postgres;Port=5432;Database=tsqr_communities;Username=tsqr;Password=CHANGE_ME_strong_db_password

# Learning service connection string
LEARNING_CONNECTION=Host=postgres;Port=5432;Database=tsqr_learning;Username=tsqr;Password=CHANGE_ME_strong_db_password


# GitHub Packages token (needed to restore tsqr-common NuGet package).
# Create one at GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens
# with at least `read:packages` scope on the lstbob org.
GITHUB_PACKAGES_TOKEN=CHANGE_ME_github_packages_token

# RS256 JWT signing keys. Autheo holds the private key; every other service
# validates with the public key. Base64-encode the PEM text, not DER:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#   base64 -w0 jwt-private.pem > jwt-private.b64
#   base64 -w0 jwt-public.pem > jwt-public.b64
# For local Docker, paste the base64 output below. Production should mount the
# private key from a secret instead of passing it as an environment variable.
JWT_PRIVATE_KEY_BASE64=CHANGE_ME_base64_encoded_pkcs8_private_key_pem
JWT_PUBLIC_KEY_BASE64=CHANGE_ME_base64_encoded_spki_public_key_pem
JWT_KEY_ID=tsqr-autheo-v1

# Optional key ring for rotation. Semicolon-separated kid=base64Pem entries.
# Leave empty for single-key operation. During rotation include the outgoing and
# incoming public keys, and deploy the verifiers before switching autheo's
# active key. Must include JWT_KEY_ID when non-empty. Example:
# JWT_PUBLIC_KEYS=tsqr-autheo-v1=<base64 spki pem>;tsqr-autheo-v2=<base64 spki pem>
JWT_PUBLIC_KEYS=

# Service-to-service key for internal endpoints. The gateway sends it to
# autheo's /internal/auth/exchange to obtain per-service tokens, identity sends
# it when exchanging its token before the autheo email change, and autheo sends
# it to tool-lib's member/community lookup. The public gateway does not proxy
# these routes. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_generate_a_random_key

# Next.js UI -> gateway (internal)
API_URL=http://gateway:8080

# Support UI external URL (for the Support tab link in tsqr-ui)
NEXT_PUBLIC_SUPPORT_URL=http://localhost:4200
